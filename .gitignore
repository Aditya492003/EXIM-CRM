# ─── Root .gitignore ─────────────────────────────────
# Covers the entire monorepo (frontend + backend)

# ── Node ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── Environment Variables & Secrets (CRITICAL — NEVER COMMIT) ──
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
firebase-service-account.json
*firebase-adminsdk*.json
!*firebase-service-account.example.json

# ── Build Outputs ─────────────────────────────────────
dist/
dist-ssr/
build/
.vite/

# ── OS / Editor ──────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.user
*.swp
*.swo
*~

# ── TypeScript ───────────────────────────────────────
*.tsbuildinfo

# ── Testing & Coverage ───────────────────────────────
coverage/
.nyc_output/

# ── Uploads (backend) ────────────────────────────────
uploads/
*.csv.tmp

# ── Misc ─────────────────────────────────────────────
.cache/
*.local
